MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/keja-yangu
JWT_SECRET=your-jwt-secret-here
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=production

# Email Configuration (Nodemailer)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password
EMAIL_FROM=Keja Yangu <no-reply@keja.co>

# Paystack online payments (test keys; keja-yangu uses test mode)
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# Notification retention: number of days a notification stays in the inbox
# before the Mongo TTL index purges it (default: 90).
NOTIFICATION_RETENTION_DAYS=90