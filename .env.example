MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/keja-yangu
JWT_SECRET=your-jwt-secret-here
# 32-byte key used to encrypt PII (national ID) at rest, in base64 or 64-char
# hex. Generate one with: openssl rand -base64 32. Required in production —
# changing it makes existing encrypted values unreadable.
FIELD_ENCRYPTION_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=production

# Email Configuration (Nodemailer)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password
EMAIL_FROM=Keja Yangu <no-reply@keja.co>
EMAIL_SECURE=false

# Paystack online payments (test keys; keja-yangu uses test mode)
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# M-Pesa (Safaricom Daraja) callback verification. Defaults to JWT_SECRET if
# unset; set explicitly in production.
MPESA_CALLBACK_SECRET=

# Commission payouts execution gate (keep false until finance sign-off).
COMMISSION_PAYOUTS_ENABLED=false

# System-admin users/roles management surface. Keep false until the bootstrap
# script has been run and the security runbook is signed off.
ROLE_MANAGEMENT_ENABLED=false

# Scoped authorization rollout. Shadow sampling compares legacy decisions with
# the scoped policy (0 disables it). Route-family enforcement is opt-in; set a
# comma-separated family list such as "units" or "*" for staging only.
# Recommended sequence (see docs/runbooks/phase9-stabilisation.md):
# 1. Shadow at 1.0 for one full cycle; zero unexplained mismatches required.
# 2. Enforce per family with a soak: chat -> units -> (invoices, tenants)
#    -> properties last. "*" is staging-only.
# Caretaker property:create / property:delete stay privilege-gated in legacy
# (no scoped override) — do not rely on enrollment to change that.
AUTHZ_SHADOW_SAMPLE_RATE=0
AUTHZ_ENFORCE_ROUTE_FAMILIES=

# Notification retention: number of days a notification stays in the inbox
# before the Mongo TTL index purges it (default: 90).
NOTIFICATION_RETENTION_DAYS=90
# UploadThing (property image uploads)
# Get your token from https://uploadthing.com/dashboard -> API Keys
UPLOADTHING_TOKEN=
# Legacy alternative: UPLOADTHING_SECRET + UPLOADTHING_APP_ID
# UPLOADTHING_SECRET=
# UPLOADTHING_APP_ID=
